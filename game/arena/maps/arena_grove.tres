[gd_resource type="Resource" script_class="MapResource" format=3]

[ext_resource type="Script" path="res://game/maps/resources/MapResource.gd" id="1_grove"]

[resource]
resource_name = "MapResource"
script = ExtResource("1_grove")
map_name = "Sunken Grove"
description = "A compact 8x8 forest duel arena. Open grass field with a few tall-grass thickets for cover, two old trees anchoring the flanks, and a small sacred meadow healing the centre. Squad musters south, waves crest in from the north."
author = "Arena Mode"
version = "1.0"
status = "Active"
width = 8
height = 8
