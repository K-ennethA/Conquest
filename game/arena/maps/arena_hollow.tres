[gd_resource type="Resource" script_class="MapResource" format=3]

[ext_resource type="Script" path="res://game/maps/resources/MapResource.gd" id="1_hollow"]

[resource]
resource_name = "MapResource"
script = ExtResource("1_hollow")
map_name = "Bramble Hollow"
description = "A compact 10x10 sunken dirt hollow. Bare packed-earth ground broken by two brackish water pools, thorny bramble thickets at the centre, and a pair of stone pillars for hard cover. Squad holds the south lip, waves pour down from the north."
author = "Arena Mode"
version = "1.0"
status = "Active"
width = 10
height = 10
