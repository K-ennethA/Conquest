[gd_resource type="Resource" script_class="AbilityResource" format=3]

[ext_resource type="Script" path="res://game/combat/effects/MoveEffect.gd" id="1_mvefx"]
[ext_resource type="Script" path="res://game/combat/effects/ShieldEffect.gd" id="2_shield"]
[ext_resource type="Script" path="res://game/abilities/AbilityResource.gd" id="3_abres"]
[ext_resource type="Script" path="res://game/abilities/UndamagedForTurnsCondition.gd" id="4_undamaged"]

[sub_resource type="Resource" id="Resource_cw_shield"]
script = ExtResource("2_shield")
amount = 15

[sub_resource type="Resource" id="Resource_cw_cond"]
script = ExtResource("4_undamaged")
turns = 3

[resource]
script = ExtResource("3_abres")
id = &"crystalline_ward"
display_name = "Crystalline Ward"
description = "Left untouched for three turns, Geode's surface grows over and crystallizes the 15 HP ward anew. It refreshes the ward it opened the battle with -- it never doubles it."
trigger = 1
condition = SubResource("Resource_cw_cond")
effects = Array[ExtResource("1_mvefx")]([SubResource("Resource_cw_shield")])
