[gd_resource type="Resource" script_class="MapResource" format=3]

[ext_resource type="Script" path="res://game/maps/resources/MapResource.gd" id="1_kcmap"]

[resource]
resource_name = "MapResource"
script = ExtResource("1_kcmap")
map_name = "King's Crossing"
description = "Two fortress-roots face each other across a sacred rise, and neither army ever stops arriving. Grunts pour endlessly from both camps and the wild guardians on the hill answer to no one -- so nobody is ever going to run out of soldiers. The only way this ends is with a base in pieces."
author = "System"
version = "1.0"
status = "Active"
width = 13
height = 11
