[resource]
script = ExtResource("1_char")
character_id = &"oakheart"
element = &"nature"
display_name = "Oakheart"
description = "A Barkling that survived long enough to take root. Heartwood where there was sapwood, bark that bites back, and at last the strength to bring a whole trunk down on whatever threatens the grove."
model_scene = ExtResource("2_model")
base_health = 96
base_attack = 21
base_defense = 16
base_magic = 4
base_magic_defense = 12
base_speed = 7
model_scale = 1.3
moveset = Array[ExtResource("3_mvres")]([ExtResource("4_bough"), ExtResource("5_rooted"), ExtResource("6_verdant"), ExtResource("7_timber")])
abilities = Array[ExtResource("8_abres")]([ExtResource("9_blessing"), ExtResource("10_thornskin")])
