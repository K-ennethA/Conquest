[resource]
script = ExtResource("1_char")
character_id = &"bastion"
element = &"earth"
display_name = "Bastion"
description = "Not a soldier -- a place. Roots driven through the bedrock hold it where it was raised, and it has never taken a step in its life. It cannot chase you, cannot flee you, and cannot be bargained with; it can only stand there being the reason your side still has somewhere to come back to. Bring it down and the ground behind it stops belonging to anyone."
model_scene = ExtResource("2_model")
base_health = 200
base_attack = 8
base_defense = 26
base_magic = 0
base_magic_defense = 20
base_speed = 1
base_movement = 0
attack_range = 1
is_boss = false
footprint = Vector2i(1, 1)
model_scale = 0.55
default_ai_stance = "defensive"
default_aggro_range = 1
default_leash_radius = 0
moveset = Array[ExtResource("3_mvres")]([ExtResource("4_ward")])
