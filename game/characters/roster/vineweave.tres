[resource]
script = ExtResource("1_char")
character_id = &"vineweave"
element = &"nature"
display_name = "Vineweave"
description = "A warrior grown rather than armed. Where hands should be, Vineweave carries a living tangle of vine that answers its will -- braiding into a blade to cleave a line of foes, a lattice shield to turn a blow, a taut bow to loose a barbed shot, or roots that burst the ground and bind an enemy where it stands."
model_scene = ExtResource("2_model")
base_health = 108
base_attack = 27
base_defense = 15
base_magic = 8
base_magic_defense = 11
base_speed = 12
base_movement = 5
attack_range = 2
movement_profile = ExtResource("8_mvprof")
model_yaw_deg = 180.0
moveset = Array[ExtResource("3_mvres")]([ExtResource("4_cleave"), ExtResource("5_thornward"), ExtResource("6_volley"), ExtResource("7_roots")])
abilities = Array[ExtResource("9_abres")]([ExtResource("10_grasscutter")])
