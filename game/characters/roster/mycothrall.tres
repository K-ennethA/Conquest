[resource]
script = ExtResource("1_char")
character_id = &"mycothrall"
display_name = "Mycothrall"
description = "A low, wet parasite that spreads flat across a tile like something poured. It cannot win a straight fight, so it doesn't try -- it lunges in, bites deep, and drinks. Left in a wound too long its threads hollow the host from the inside and take the reins, and the thing you were protecting turns and swings at the ally beside it."
model_scene = ExtResource("2_model")
base_health = 38
base_attack = 13
base_defense = 6
base_magic = 6
base_magic_defense = 7
base_speed = 14
base_movement = 5
min_difficulty = 2
moveset = Array[ExtResource("3_mvres")]([ExtResource("4_lunge"), ExtResource("5_siphon")])
abilities = Array[ExtResource("6_abres")]([ExtResource("7_parasitic")])
