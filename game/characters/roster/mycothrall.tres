[gd_resource type="Resource" script_class="CharacterResource" format=3]

[ext_resource type="Script" path="res://game/characters/CharacterResource.gd" id="1_char"]
[ext_resource type="PackedScene" path="res://game/characters/models/forest/mycothrall.glb" id="2_model"]
[ext_resource type="Script" path="res://game/combat/MoveResource.gd" id="3_mvres"]
[ext_resource type="Resource" path="res://game/combat/moves/infesting_lunge.tres" id="4_lunge"]
[ext_resource type="Resource" path="res://game/combat/moves/siphon_bite.tres" id="5_siphon"]
