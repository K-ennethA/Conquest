[resource]
script = ExtResource("1_char")
character_id = &"blightcap"
display_name = "Blightcap"
description = "A squat, wet-looking fungus that walks on a knot of root-legs and smells like a turned log. It cannot chase anything down, so it waits, throws itself the last few paces, and hammers at whatever it reaches until the rot it carries does the rest. Killing one is not the end of the exchange -- the cap ruptures and coats everything standing over it."
model_scene = ExtResource("2_model")
base_health = 52
base_attack = 14
base_defense = 9
base_magic = 6
base_magic_defense = 11
base_speed = 6
base_movement = 6
model_scale = 0.55
moveset = Array[ExtResource("3_mvres")]([ExtResource("4_burst"), ExtResource("5_leap")])
abilities = Array[ExtResource("6_abres")]([ExtResource("7_deathbloom")])
