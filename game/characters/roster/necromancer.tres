[resource]
script = ExtResource("1_char")
character_id = &"necromancer"
element = &"dark"
display_name = "Mortis"
description = "A gravecaller who wages war with your own dead. Every soldier he cuts down rises again at his side, so the longer the battle drags on, the larger his silent army grows."
model_scene = ExtResource("2_model")
base_health = 90
base_attack = 8
base_defense = 10
base_magic = 30
base_magic_defense = 18
base_speed = 11
base_movement = 4
attack_range = 3
movement_profile = ExtResource("10_mvprof")
model_yaw_deg = 180.0
moveset = Array[ExtResource("3_mvres")]([ExtResource("4_wither"), ExtResource("5_grasp"), ExtResource("6_drain"), ExtResource("7_legion")])
abilities = Array[ExtResource("8_abres")]([ExtResource("9_reanimate")])
