abilities = Array[ExtResource("8_abres")]([ExtResource("9_reanimate")])
model_scale = 1.04405
; owner 2026-10-12 (roster page): Mortis is a HUMAN of the grim type. A human fields at most 3 specials after the weapon attack, so Wither Bolt (now covered by the staff strike) left the kit: Grave Grasp, Soul Drain, Undying Legion (raises Rotwights) + Reanimate; PLACEHOLDER weapon oak_staff, proficiencies staff + tome.
weapon = ExtResource("20_weapon")
weapon_proficiencies = Array[StringName]([&"staff", &"tome"])
weapon_tendency = &"staff"
