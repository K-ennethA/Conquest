[gd_resource type="Resource" script_class="CharacterResource" format=3]

[ext_resource type="Script" path="res://game/characters/CharacterResource.gd" id="1_char"]
[ext_resource type="PackedScene" path="res://game/characters/models/dark/necromancer.glb" id="2_model"]
[ext_resource type="Script" path="res://game/combat/MoveResource.gd" id="3_mvres"]
[ext_resource type="Resource" path="res://game/combat/moves/wither_bolt.tres" id="4_wither"]
[ext_resource type="Resource" path="res://game/combat/moves/grave_grasp.tres" id="5_grasp"]
[ext_resource type="Resource" path="res://game/combat/moves/soul_drain.tres" id="6_drain"]
[ext_resource type="Resource" path="res://game/combat/moves/undying_legion.tres" id="7_legion"]
