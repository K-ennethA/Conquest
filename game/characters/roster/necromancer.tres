[resource]
script = ExtResource("1_char")
character_id = &"necromancer"
element = &"grim"
kind = 1
display_name = "Mortis"
description = "A gravecaller who wages war with your own dead. Every soldier he cuts down rises again at his side, so the longer the battle drags on, the larger his silent army grows."
model_scene = ExtResource("2_model")
base_health = 90
base_attack = 8
base_defense = 10
base_magic = 30
base_magic_defense = 18
base_speed = 11
base_movement = 4
attack_range = 3
