[gd_resource type="Resource" script_class="CharacterResource" format=3]

[ext_resource type="Script" path="res://game/characters/CharacterResource.gd" id="1_char"]
[ext_resource type="PackedScene" path="res://game/characters/models/earth/gem_knight.glb" id="2_model"]
[ext_resource type="Script" path="res://game/combat/MoveResource.gd" id="3_mvres"]
[ext_resource type="Resource" path="res://game/combat/moves/prism_bulwark.tres" id="4_bulwark"]
[ext_resource type="Resource" path="res://game/combat/moves/stone_sling.tres" id="5_sling"]
[ext_resource type="Resource" path="res://game/combat/moves/scree_trap.tres" id="6_trap"]
[ext_resource type="Resource" path="res://game/combat/moves/refraction_lance.tres" id="7_lance"]
[ext_resource type="Script" path="res://game/abilities/AbilityResource.gd" id="8_abres"]
[ext_resource type="Resource" path="res://game/abilities/crystalline_ward.tres" id="9_ward"]
[ext_resource type="Resource" path="res://game/abilities/reprisal.tres" id="10_reprisal"]
