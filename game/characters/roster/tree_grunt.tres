[resource]
script = ExtResource("1_char")
character_id = &"tree_grunt"
display_name = "Tree Grunt"
description = "A lurching sapling animated by the Great Tree's will. Slow and brittle alone, but the forest never sends just one."
model_scene = ExtResource("2_model")
base_health = 55
base_attack = 14
base_defense = 8
base_magic = 2
base_magic_defense = 6
base_speed = 7
base_movement = 2
attack_range = 1
is_boss = false
footprint = Vector2i(1, 1)
