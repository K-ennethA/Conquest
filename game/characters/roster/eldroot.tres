[gd_resource type="Resource" script_class="CharacterResource" format=3]

[ext_resource type="Script" path="res://game/characters/CharacterResource.gd" id="1_char"]
[ext_resource type="PackedScene" path="res://game/characters/models/forest/eldroot.glb" id="2_model"]
[ext_resource type="Script" path="res://game/combat/MoveResource.gd" id="3_mvres"]
[ext_resource type="Resource" path="res://game/combat/moves/bough_sweep.tres" id="4_bough"]
[ext_resource type="Resource" path="res://game/combat/moves/heartwood_guard.tres" id="5_guard"]
[ext_resource type="Resource" path="res://game/combat/moves/timberfall.tres" id="6_timber"]
