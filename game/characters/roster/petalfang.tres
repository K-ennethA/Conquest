[gd_resource type="Resource" script_class="CharacterResource" format=3]

[ext_resource type="Script" path="res://game/characters/CharacterResource.gd" id="1_char"]
[ext_resource type="PackedScene" path="res://game/characters/models/forest/petalfang.glb" id="2_model"]
[ext_resource type="Script" path="res://game/combat/MoveResource.gd" id="3_mvres"]
[ext_resource type="Resource" path="res://game/combat/moves/thorn_spit.tres" id="4_thorn"]
[ext_resource type="Resource" path="res://game/combat/moves/vine_trap.tres" id="5_trap"]
[ext_resource type="Resource" path="res://game/combat/moves/gathering_vines.tres" id="6_vines"]
