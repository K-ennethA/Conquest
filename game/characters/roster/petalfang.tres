[resource]
script = ExtResource("1_char")
character_id = &"petalfang"
element = &"nature"
display_name = "Petalfang"
description = "A sprawling vine-serpent crowned with a wet, over-large blossom. Petalfang does not chase -- it seeds the ground with runners, spits thorns from cover, and waits for something to stop struggling."
model_scene = ExtResource("2_model")
base_health = 42
base_attack = 13
base_defense = 5
base_magic = 17
base_magic_defense = 9
base_speed = 10
attack_range = 3
model_yaw_deg = 180.0
moveset = Array[ExtResource("3_mvres")]([ExtResource("4_thorn"), ExtResource("5_trap"), ExtResource("6_vines"), ExtResource("7_ingrained")])
abilities = Array[ExtResource("8_abres")]([ExtResource("9_thornlust")])
