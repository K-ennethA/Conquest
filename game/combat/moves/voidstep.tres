[resource]
script = ExtResource("3_mvres")
move_id = &"voidstep"
display_name = "Voidstep"
description = "Tears a void spot into distant ground -- or, if the ground already holds one of its own, steps through it and comes out standing there. Up to three marks at a time; they fade after a dozen turns. Marking is cheap; stepping is not."
category = 1
element = &"dark"
energy_cost = 0
max_uses = -1
cooldown = 1
accuracy = 1.0
crit_chance = 0.0
targeting = SubResource("Resource_vs_tgt")
