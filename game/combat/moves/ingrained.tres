[gd_resource type="Resource" script_class="MoveResource" format=3]

[ext_resource type="Script" path="res://game/combat/effects/MoveEffect.gd" id="1_moveeffect"]
[ext_resource type="Script" path="res://game/combat/effects/ApplyStatusEffect.gd" id="2_applystatus"]
[ext_resource type="Script" path="res://game/combat/effects/StatModifierEffect.gd" id="3_statmod"]
[ext_resource type="Script" path="res://game/combat/MoveResource.gd" id="4_mvres"]
[ext_resource type="Script" path="res://game/combat/TargetingPattern.gd" id="5_targp"]
[ext_resource type="Resource" path="res://game/combat/status/ingrained.tres" id="6_ingrained"]

[sub_resource type="Resource" id="Resource_ingrained_root"]
script = ExtResource("2_applystatus")
condition = ExtResource("6_ingrained")

[sub_resource type="Resource" id="Resource_ingrained_reach"]
script = ExtResource("3_statmod")
stat_name = "range_bonus"
amount = 2
duration = 5

[sub_resource type="Resource" id="Resource_ingrained_tgt"]
script = ExtResource("5_targp")
target_kind = 0
min_range = 0
max_range = 0
area_shape = 0
area_size = 0
affects_caster_tile = true

[resource]
script = ExtResource("4_mvres")
move_id = &"ingrained"
display_name = "Ingrained"
description = "Petalfang drives its root-tail deep and splits open into a broad, staring bloom. It cannot take a single step like this, but every thorn and runner it commands reaches far further."
category = 1
element = &"nature"
energy_cost = 0
max_uses = -1
cooldown = 6
accuracy = 1.0
crit_chance = 0.0
targeting = SubResource("Resource_ingrained_tgt")
effects = Array[ExtResource("1_moveeffect")]([SubResource("Resource_ingrained_root"), SubResource("Resource_ingrained_reach")])
