min_range = 1
max_range = 3
area_shape = 0
area_size = 0
affects_caster_tile = false

[resource]
script = ExtResource("4_mvres")
move_id = &"shadow_dash"
display_name = "Shadow Dash"
description = "Tears straight through the enemy line, cutting everything it passes, and comes out the far side still moving -- though slower."
category = 1
element = &"dark"
energy_cost = 0
max_uses = -1
cooldown = 3
accuracy = 1.0
crit_chance = 0.0
targeting = SubResource("Resource_sd_tgt")
effects = Array[ExtResource("1_moveeffect")]([SubResource("Resource_sd_dash"), SubResource("Resource_sd_surge")])
