[gd_resource type="Resource" script_class="MoveResource" format=3]

[ext_resource type="Script" path="res://game/combat/effects/MoveEffect.gd" id="1_mvefx"]
[ext_resource type="Script" path="res://game/combat/effects/SetWeatherEffect.gd" id="2_setw"]
[ext_resource type="Script" path="res://game/combat/MoveResource.gd" id="4_mvres"]
[ext_resource type="Script" path="res://game/combat/TargetingPattern.gd" id="5_targp"]

[sub_resource type="Resource" id="Resource_vc_weather"]
script = ExtResource("2_setw")
weather = &"overbloom"
rounds = 3

[sub_resource type="Resource" id="Resource_vc_target"]
script = ExtResource("5_targp")
target_kind = 0
min_range = 0
max_range = 0
affects_caster_tile = true

[resource]
script = ExtResource("4_mvres")
move_id = &"verdant_call"
display_name = "Verdant Call"
description = "Calls the forest into Overbloom for 3 rounds: Nature units heal 1/10 max HP each turn and Nature moves hit x1.15."
category = 1
element = &"nature"
cooldown = 6
targeting = SubResource("Resource_vc_target")
effects = Array[ExtResource("1_mvefx")]([SubResource("Resource_vc_weather")])
