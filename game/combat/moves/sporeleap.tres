[gd_resource type="Resource" script_class="MoveResource" format=3]

[ext_resource type="Script" path="res://game/combat/effects/MoveEffect.gd" id="1_moveeffect"]
[ext_resource type="Script" path="res://game/combat/effects/LeapEffect.gd" id="2_leap"]
[ext_resource type="Script" path="res://game/combat/effects/DamageEffect.gd" id="3_damage"]
[ext_resource type="Script" path="res://game/combat/MoveResource.gd" id="4_mvres"]
[ext_resource type="Script" path="res://game/combat/TargetingPattern.gd" id="5_targp"]

[sub_resource type="Resource" id="Resource_sporeleap_leap"]
script = ExtResource("2_leap")
description_override = "Leap to the chosen space beside your prey"

[sub_resource type="Resource" id="Resource_sporeleap_dmg"]
script = ExtResource("3_damage")
power = 7
scaling_stat = "attack"
scale = 0.6
category = 0

[sub_resource type="Resource" id="Resource_sporeleap_tgt"]
script = ExtResource("5_targp")
target_kind = 2
min_range = 1
max_range = 4
area_shape = 1
area_size = 1
affects_caster_tile = false
requires_empty_cell = true
requires_adjacent_enemy = true

[resource]
script = ExtResource("4_mvres")
move_id = &"sporeleap"
display_name = "Spore Leap"
description = "Leaps to an empty space beside a target, damaging adjacent enemies."
category = 0
element = &"nature"
energy_cost = 0
max_uses = -1
cooldown = 3
accuracy = 1.0
crit_chance = 0.0
targeting = SubResource("Resource_sporeleap_tgt")
effects = Array[ExtResource("1_moveeffect")]([SubResource("Resource_sporeleap_leap"), SubResource("Resource_sporeleap_dmg")])
