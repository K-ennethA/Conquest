[sub_resource type="Resource" id="Resource_hmo3s"]
script = ExtResource("8_0oxq0")
prompt = SubResource("Resource_32eok")
options = Array[Resource]([SubResource("Resource_lixbm"), SubResource("Resource_1l4j0")])

[sub_resource type="Resource" id="Resource_hrtya"]
