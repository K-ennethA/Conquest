clash_intro = true
enemy_level = 25
boss_battle = true

[sub_resource type="Resource" id="Resource_58ly1"]
script = ExtResource("10_w8qoe")
spec = SubResource("Resource_8l1pl")

[sub_resource type="Resource" id="Resource_7c8bm"]
