options = Array[Resource]([SubResource("Resource_s2voi"), SubResource("Resource_g2gsi")])

[sub_resource type="Resource" id="Resource_8l1pl"]
script = ExtResource("11_mspkm")
encounter_id = "tides.legend"
map_path = "res://game/overworld/content/battles/ow_tides_depths.tres"
