commands = Array[Resource]([SubResource("Resource_ohja0"), SubResource("Resource_vcumk"), SubResource("Resource_hc6qb")])

[sub_resource type="Resource" id="Resource_g2gsi"]
script = ExtResource("6_jtbn2")
label = "Not now"
is_cancel = true

[sub_resource type="Resource" id="Resource_v3f3b"]
script = ExtResource("7_f5jvp")
text = "Vineweave watches you, still. Bond with it?"
clear_portraits = true

[sub_resource type="Resource" id="Resource_wvtia"]
script = ExtResource("8_0oxq0")
