[sub_resource type="Resource" id="Resource_hdkaw"]
script = ExtResource("2_c8k5q")
speaker_id = &"self"
side = &"right"
text = "Ah -- a Warden's coat. I had hoped one would come."

[sub_resource type="Resource" id="Resource_uve6t"]
script = ExtResource("2_c8k5q")
speaker_id = &"self"
side = &"right"
text = "The Mossway is sick. The blight walks it at night, and the grass has started to bite."

[sub_resource type="Resource" id="Resource_ir736"]
script = ExtResource("5_01a5j")
beats = Array[Resource]([SubResource("Resource_hdkaw"), SubResource("Resource_uve6t")])

[sub_resource type="Resource" id="Resource_yn6om"]
script = ExtResource("7_yl85t")
key = "quest.blight_road"

[sub_resource type="Resource" id="Resource_8o61w"]
script = ExtResource("2_c8k5q")
speaker_id = &"self"
side = &"right"
text = "Then the forest has not forgotten us after all. Take this -- it kept my grandmother's roots steady."

[sub_resource type="Resource" id="Resource_w7agi"]
script = ExtResource("5_01a5j")
