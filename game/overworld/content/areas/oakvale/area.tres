id = &"maren"
cell = Vector3i(6, 9, 0)
facing = "east"
display_name = "Maren"
tint = Color(0.62, 0.36, 0.3, 1)

[sub_resource type="Resource" id="Resource_0rsdw"]
script = ExtResource("2_c8k5q")
speaker_id = &"self"
side = &"right"
text = "My brother went down the Mossway for moss-caps. Came back white as a ghost -- said the grass itself snapped at him."

[sub_resource type="Resource" id="Resource_bskvf"]
script = ExtResource("5_01a5j")
beats = Array[Resource]([SubResource("Resource_0rsdw")])

[sub_resource type="Resource" id="Resource_qebhi"]
script = ExtResource("2_c8k5q")
speaker_id = &"self"
side = &"right"
text = "Bram's out on the Mossway. Thinks he's a Warden already -- he'll want to test you."

[sub_resource type="Resource" id="Resource_5ymmf"]
script = ExtResource("5_01a5j")
beats = Array[Resource]([SubResource("Resource_qebhi")])

[sub_resource type="Resource" id="Resource_20uh4"]
