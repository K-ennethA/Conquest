[sub_resource type="Resource" id="Resource_6igoc"]
script = ExtResource("3_t0i4t")
text = "OAKVALE
East: the Mossway to River Crossing, then north over the Old Bridge to Crownhaven.
West: Farm Hamlet.  South: the sea.
Travellers, mind the grass."
id = &"town_sign"
cell = Vector3i(19, 8, 0)
display_name = "Oakvale"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_g2n42"]
script = ExtResource("3_t0i4t")
text = "THE STRAND
Oakvale's shingle beach and the fishing jetty. The tide comes in faster than you think."
id = &"strand_sign"
cell = Vector3i(11, 18, 0)
display_name = "The Strand"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_wljw8"]
script = ExtResource("3_t0i4t")
text = "A notice is nailed to the door:
\"By order of Aldermere's crown: shards of starstone will be granted to chosen testers at Crownhaven. One tester is called from Oakvale, at the Royal Researcher's own request: {hero}.\""
id = &"hall_sign"
cell = Vector3i(13, 5, 0)
display_name = "Village Hall"
tint = Color(0.52, 0.36, 0.2, 1)

