[sub_resource type="Resource" id="Resource_34oop"]
script = ExtResource("11_mfhw7")
label = "I will walk it."
commands = Array[Resource]([SubResource("Resource_yn6om"), SubResource("Resource_w7agi"), SubResource("Resource_6igoc"), SubResource("Resource_g2n42"), SubResource("Resource_wljw8"), SubResource("Resource_di53x")])

[sub_resource type="Resource" id="Resource_ev43m"]
script = ExtResource("2_c8k5q")
speaker_id = &"self"
side = &"right"
text = "Come back when your roots are steady. The Mossway will wait -- the rot will not."

[sub_resource type="Resource" id="Resource_acj8h"]
