[sub_resource type="Resource" id="Resource_cwe1v"]
script = ExtResource("6_8wnmi")
text = "The cart track west of the mill runs on through the barley toward Farm Hamlet. A hurdle gate across it is tied shut with a ribbon: \"Harvest in progress -- back soon.\""
clear_portraits = true

[sub_resource type="Resource" id="Resource_t1qba"]
