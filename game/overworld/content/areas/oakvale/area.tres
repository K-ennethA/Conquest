[sub_resource type="Resource" id="Resource_5l2ld"]
script = ExtResource("6_8wnmi")
speaker_name = "Conquest"
text = "Long ago, a star fell on this world. Its dust sank into the stone and the soil, and ever since, humans and creatures alike have called on the elements."
clear_portraits = true

[sub_resource type="Resource" id="Resource_5o6tp"]
script = ExtResource("6_8wnmi")
text = "Few people ever bond with a creature. It takes years of patient trust -- or chains. But in the royal city, a boy from this very village grew up to be the King's researcher -- and he has cut a shard of starstone that makes the bond easy and safe."
clear_portraits = true

[sub_resource type="Resource" id="Resource_7pch5"]
script = ExtResource("10_yl85t")
beats = Array[Resource]([SubResource("Resource_5l2ld"), SubResource("Resource_5o6tp")])

[sub_resource type="Resource" id="Resource_t0cp8"]
script = ExtResource("11_jaygs")
actor = "player"
facing = "toward:briony"

[sub_resource type="Resource" id="Resource_nu6ts"]
script = ExtResource("6_8wnmi")
speaker_id = &"npc_briony"
speaker_name = "Briony"
side = &"right"
text = "There you are! Today's the day, {hero}. Linnea's letter says noon -- you'll be late if you dawdle."

[sub_resource type="Resource" id="Resource_yw5pv"]
script = ExtResource("6_8wnmi")
speaker_id = &"npc_briony"
speaker_name = "Briony"
side = &"right"
text = "Fancy that. The boy who used to follow you round the barley field, the King's own researcher -- and he asked for YOU by name. One of his chosen testers."

[sub_resource type="Resource" id="Resource_75jx2"]
script = ExtResource("6_8wnmi")
speaker_id = &"npc_briony"
speaker_name = "Briony"
side = &"right"
text = "A shard of your own, and a creature to go with it. Your father would have been so proud."

[sub_resource type="Resource" id="Resource_4k0pl"]
script = ExtResource("6_8wnmi")
speaker_id = &"hero"
text = "I'll be home before dark, Mother. I promise. And I'll make Linnea tell me everything."

[sub_resource type="Resource" id="Resource_aesbt"]
script = ExtResource("6_8wnmi")
speaker_id = &"npc_briony"
speaker_name = "Briony"
side = &"right"
text = "Follow the Mossway east to River Crossing, and the road north over the bridge to Crownhaven. The wild ones in the grass leave a traveller alone -- until you walk with a partner of your own. Then mind yourself."

[sub_resource type="Resource" id="Resource_4t2ot"]
script = ExtResource("6_8wnmi")
speaker_id = &"npc_briony"
speaker_name = "Briony"
side = &"right"
text = "Go on, then. And {hero} -- I love you. Bring your new friend home for supper. Both of them, if Linnea can tear himself away from his work."

[sub_resource type="Resource" id="Resource_sl0el"]
script = ExtResource("10_yl85t")
beats = Array[Resource]([SubResource("Resource_nu6ts"), SubResource("Resource_yw5pv"), SubResource("Resource_75jx2"), SubResource("Resource_4k0pl"), SubResource("Resource_aesbt"), SubResource("Resource_4t2ot")])

