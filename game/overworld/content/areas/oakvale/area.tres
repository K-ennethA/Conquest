[sub_resource type="Resource" id="Resource_4hl7o"]
script = ExtResource("2_c8k5q")
speaker_id = &"self"
side = &"right"
text = "Hale will open the east gate. Mind Bram on the road -- the boy means well."

[sub_resource type="Resource" id="Resource_di53x"]
