[sub_resource type="Resource" id="Resource_02t2l"]
script = ExtResource("1_urwkg")
text = "OAKVALE -- where the Mossway begins.
Travellers, mind the grass."
id = &"town_sign"
cell = Vector3i(17, 8, 0)
display_name = "Oakvale"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_47vhf"]
script = ExtResource("1_urwkg")
text = "The door is barred. A note is pinned to it: \"Gone to the mill.\""
id = &"cottage_door"
cell = Vector3i(3, 6, 0)
display_name = "Mira's Cottage"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_j6r5d"]
script = ExtResource("1_urwkg")
text = "The forge is cold. Chalked on the door: \"Closed until the road is safe.\""
id = &"smithy_door"
cell = Vector3i(14, 5, 0)
display_name = "The Smithy"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_cu3oh"]
script = ExtResource("2_c8k5q")
speaker_id = &"self"
side = &"right"
text = "The Elder has been pacing by the Wayshrine since dawn. Something about the road east."

[sub_resource type="Resource" id="Resource_oy7lt"]
script = ExtResource("2_c8k5q")
speaker_id = &"self"
side = &"right"
text = "If you're hurt, touch the Wayshrine. It remembers everyone who drinks from it."

[sub_resource type="Resource" id="Resource_46w87"]
script = ExtResource("3_8wnmi")
scene_id = &"oak_maren"
beats = Array[Resource]([SubResource("Resource_cu3oh"), SubResource("Resource_oy7lt")])

[sub_resource type="Resource" id="Resource_d8qq0"]
script = ExtResource("4_037wj")
speaker_id = &"npc_maren"
