[sub_resource type="Resource" id="Resource_bskvf"]
script = ExtResource("3_t0i4t")
text = "OAKVALE
East: the Mossway, and Crownhaven beyond it.
Travellers, mind the grass."
id = &"town_sign"
cell = Vector3i(19, 8, 0)
display_name = "Oakvale"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_qebhi"]
script = ExtResource("3_t0i4t")
text = "A notice is nailed to the door:
\"By order of Aldermere's crown: shards of starstone will be granted to chosen testers at Crownhaven. Oakvale's name was drawn.\""
id = &"hall_sign"
cell = Vector3i(13, 5, 0)
display_name = "Village Hall"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_5ymmf"]
script = ExtResource("4_urwkg")
speaker_id = &"npc_briony"
speaker_name = "Briony"
side = &"right"
text = "Crownhaven is east, along the Mossway. Go on -- the Researcher won't wait all day, and neither will I!"

