[sub_resource type="Resource" id="Resource_862c6"]
script = ExtResource("4_urwkg")
speaker_name = "Conquest"
text = "Long ago, a star fell on this world. Its dust sank into the stone and the soil, and ever since, humans and creatures alike have called on the elements."
clear_portraits = true

[sub_resource type="Resource" id="Resource_3ie2q"]
script = ExtResource("4_urwkg")
text = "Few people ever bond with a creature. It takes years of patient trust -- or chains. But in the royal city, a researcher has cut a shard of starstone that makes the bond easy and safe."
clear_portraits = true

[sub_resource type="Resource" id="Resource_ptury"]
script = ExtResource("5_c8k5q")
beats = Array[Resource]([SubResource("Resource_862c6"), SubResource("Resource_3ie2q")])

[sub_resource type="Resource" id="Resource_x0kta"]
script = ExtResource("11_jaygs")
actor = "player"
facing = "toward:briony"

[sub_resource type="Resource" id="Resource_47kwg"]
script = ExtResource("4_urwkg")
speaker_id = &"npc_briony"
speaker_name = "Briony"
side = &"right"
text = "There you are! Today's the day, {hero}. The letter says noon -- you'll be late if you dawdle."

[sub_resource type="Resource" id="Resource_lq83w"]
script = ExtResource("4_urwkg")
speaker_id = &"npc_briony"
speaker_name = "Briony"
side = &"right"
text = "One of Researcher Linnea's chosen testers. A shard of your own, and a creature to go with it. Your father would have been so proud."

[sub_resource type="Resource" id="Resource_lw70m"]
script = ExtResource("4_urwkg")
speaker_id = &"hero"
text = "I'll be home before dark, Mother. I promise."

[sub_resource type="Resource" id="Resource_dkdgj"]
script = ExtResource("4_urwkg")
speaker_id = &"npc_briony"
speaker_name = "Briony"
side = &"right"
text = "Follow the Mossway east to Crownhaven. The wild ones in the grass leave a traveller alone -- until you walk with a partner of your own. Then mind yourself."

[sub_resource type="Resource" id="Resource_cwe1v"]
script = ExtResource("4_urwkg")
speaker_id = &"npc_briony"
speaker_name = "Briony"
side = &"right"
text = "Go on, then. And {hero} -- I love you. Bring your new friend home for supper."

[sub_resource type="Resource" id="Resource_t1qba"]
script = ExtResource("5_c8k5q")
beats = Array[Resource]([SubResource("Resource_47kwg"), SubResource("Resource_lq83w"), SubResource("Resource_lw70m"), SubResource("Resource_dkdgj"), SubResource("Resource_cwe1v")])

