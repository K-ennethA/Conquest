[sub_resource type="Resource" id="Resource_hdkaw"]
script = ExtResource("4_urwkg")
speaker_id = &"npc_tobin"
speaker_name = "Tobin"
side = &"right"
text = "Off to get your shard, then? Pa says in his day you befriended a creature by sharing your bread with it for a year."

[sub_resource type="Resource" id="Resource_uve6t"]
script = ExtResource("4_urwkg")
speaker_id = &"npc_tobin"
