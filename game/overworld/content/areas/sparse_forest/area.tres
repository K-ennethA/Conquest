[sub_resource type="Resource" id="Resource_sff5d"]
script = ExtResource("5_xx1b6")
speaker_id = &"npc_alder"
speaker_name = "Woodsman Alder"
side = &"right"
text = "Sparse, they call it. Sparse! Every tree you see here, my grandfather planted, and every tree you don't, he cut. It's a garden, really."

[sub_resource type="Resource" id="Resource_8canv"]
script = ExtResource("5_xx1b6")
speaker_id = &"npc_alder"
speaker_name = "Woodsman Alder"
side = &"right"
text = "West of the town the woods close up for good -- the Deep Woods. Nobody plants those. Nobody cuts them, either."

