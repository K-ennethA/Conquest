[sub_resource type="Resource" id="Resource_xrnt7"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "{hero}! You came -- you actually came! Look at you. Come here."

[sub_resource type="Resource" id="Resource_r2e53"]
script = ExtResource("6_vdhnd")
speaker_id = &"hero"
text = "Linnea! The King's own researcher, and you STILL can't keep the ink off your sleeves."

[sub_resource type="Resource" id="Resource_tuykd"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "Twelve years since I left Oakvale, and you notice the ink first. Some things never change. Come in, come in -- mind the cables. I've waited months to show you this."

[sub_resource type="Resource" id="Resource_8fx3e"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "You remember the old ways. Chains of starstone, forged hot, for lords who wanted obedience. Years of bread and patience for the rare few who wanted a friend. Most folk got neither, and learned to fear creatures instead."

[sub_resource type="Resource" id="Resource_obnvj"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "This is my invention: the bonding shard. The same starstone -- but cut thin and tuned on that pylon until it stops ringing and starts to LISTEN."

[sub_resource type="Resource" id="Resource_yocek"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "Every creature carries a spark of the star that fell. The shard hums with that spark. Hold it out and it carries what you MEAN, heart to heart -- the trust the slow way takes years to build, in a single heartbeat."

[sub_resource type="Resource" id="Resource_ebpx6"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "No chain, no force. It only works if you both want it. Almost anyone could do it -- which is why only a handful of testers have one yet, and the army a few crates. I'm told to hand them out slowly, and never to say where they're kept."

[sub_resource type="Resource" id="Resource_4qfn1"]
script = ExtResource("6_vdhnd")
speaker_id = &"hero"
text = "And you picked me."

[sub_resource type="Resource" id="Resource_ceppj"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "Of course I picked you. I wanted the first proof to be someone I'd trust with my life. Now -- some friends of mine have been waiting to meet you."

[sub_resource type="Resource" id="Resource_ilrci"]
script = ExtResource("7_ej8je")
