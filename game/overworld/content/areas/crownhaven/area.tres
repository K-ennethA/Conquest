[sub_resource type="Resource" id="Resource_tev24"]
script = ExtResource("4_bxhkq")
speaker_id = &"npc_dalla"
speaker_name = "Dalla"
side = &"right"
text = "Everyone wants to talk shards today. Nobody wants to buy turnips. You'd think a bit of glowing rock was worth more than supper."

[sub_resource type="Resource" id="Resource_5g8t5"]
script = ExtResource("5_hodus")
beats = Array[Resource]([SubResource("Resource_tev24")])

[sub_resource type="Resource" id="Resource_wio6u"]
script = ExtResource("4_bxhkq")
speaker_id = &"npc_dalla"
speaker_name = "Dalla"
side = &"right"
text = "Raiders, in the royal city! In broad daylight! What's next -- dragons in the fish stall?"

