[sub_resource type="Resource" id="Resource_5th03"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_kit"
speaker_name = "Kit"
side = &"right"
text = "Mum says I'm not allowed past the fountain till the soldiers catch them."

