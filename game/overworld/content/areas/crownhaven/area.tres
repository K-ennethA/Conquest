[sub_resource type="Resource" id="Resource_751mc"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Sergeant Rowan, Crownhaven Guard. You'll be one of the Researcher's testers, then."

[sub_resource type="Resource" id="Resource_u4em2"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "The army got a crate of her shards. Mine's bonded to a Geode that could hold a bridge by itself. Takes the recruits a month to stop flinching at it."

[sub_resource type="Resource" id="Resource_11qh5"]
script = ExtResource("5_efaci")
beats = Array[Resource]([SubResource("Resource_751mc"), SubResource("Resource_u4em2")])

[sub_resource type="Resource" id="Resource_o8ogv"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Rest while you can. We ride when the council stops shouting."

[sub_resource type="Resource" id="Resource_tev24"]
script = ExtResource("5_efaci")
beats = Array[Resource]([SubResource("Resource_o8ogv")])

[sub_resource type="Resource" id="Resource_5g8t5"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Geode's still shaking off the last bout. Rest up at the Wayshrine, then come and find me."

[sub_resource type="Resource" id="Resource_wio6u"]
script = ExtResource("5_efaci")
beats = Array[Resource]([SubResource("Resource_5g8t5")])

[sub_resource type="Resource" id="Resource_edvgs"]
script = ExtResource("10_648o0")
kind = 1
encounter_id = "crownhaven.spar.rowan"
opponent_name = "Sergeant Rowan"
opponent_speaker_id = &"npc_rowan"
opponent_team = Array[Dictionary]([{
"character_id": "gem_knight",
"strength": 0.8
}])
defeat_policy = 1
spar = true

[sub_resource type="Resource" id="Resource_nyo3i"]
script = ExtResource("9_e608x")
spec = SubResource("Resource_edvgs")

[sub_resource type="Resource" id="Resource_t52w8"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "On your feet. That's what spars are for -- come back when you're ready."

[sub_resource type="Resource" id="Resource_nf67m"]
script = ExtResource("5_efaci")
beats = Array[Resource]([SubResource("Resource_t52w8")])

[sub_resource type="Resource" id="Resource_agusx"]
script = ExtResource("6_vdhnd")
condition = "outcome() == \"defeat\""
then_commands = Array[Resource]([SubResource("Resource_nf67m")])

[sub_resource type="Resource" id="Resource_xp1ow"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Ha! Geode felt that one. You're learning."

[sub_resource type="Resource" id="Resource_jusve"]
script = ExtResource("5_efaci")
beats = Array[Resource]([SubResource("Resource_xp1ow")])

[sub_resource type="Resource" id="Resource_4fsp6"]
script = ExtResource("6_vdhnd")
condition = "outcome() == \"victory\""
then_commands = Array[Resource]([SubResource("Resource_jusve")])
else_commands = Array[Resource]([SubResource("Resource_agusx")])

[sub_resource type="Resource" id="Resource_fsimy"]
script = ExtResource("11_ustyd")
label = "Let's spar."
commands = Array[Resource]([SubResource("Resource_nyo3i"), SubResource("Resource_4fsp6")])

[sub_resource type="Resource" id="Resource_d54lh"]
script = ExtResource("11_ustyd")
label = "Not now."
is_cancel = true

[sub_resource type="Resource" id="Resource_8uuun"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Want to keep your partner sharp? Geode could use the exercise. A friendly bout -- nobody gets hurt for real."

[sub_resource type="Resource" id="Resource_nck7i"]
script = ExtResource("12_fsv0l")
prompt = SubResource("Resource_8uuun")
options = Array[Resource]([SubResource("Resource_fsimy"), SubResource("Resource_d54lh")])

[sub_resource type="Resource" id="Resource_y6duq"]
script = ExtResource("6_vdhnd")
condition = "spar_ready(\"crownhaven.spar.rowan\")"
then_commands = Array[Resource]([SubResource("Resource_nck7i")])
else_commands = Array[Resource]([SubResource("Resource_wio6u")])

[sub_resource type="Resource" id="Resource_128su"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "You came. Good. I'm sorry about Oakvale -- I mean that."

[sub_resource type="Resource" id="Resource_vasqq"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "The council's been shouting since dawn. Cindral's envoy swears his people never sent a raider across the border. Half the lords want to march tomorrow."

[sub_resource type="Resource" id="Resource_mn5fx"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "But those chains, {hero}. Cindral doesn't forge starstone. Someone armed those raiders -- and I mean to find out who before this turns into a war."

[sub_resource type="Resource" id="Resource_3asjm"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "I've asked for you on my detail. Rest up at the Wayshrine. When you're ready, we ride."

