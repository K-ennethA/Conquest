speaker_id = &"npc_kit"
speaker_name = "Kit"
side = &"right"
text = "I saw the Sergeant's Geode this morning! It was THIS big. Bigger! When I'm a tester I'm getting two."

[sub_resource type="Resource" id="Resource_8abdv"]
