actor = "starter"
glyph = "?"

[sub_resource type="Resource" id="Resource_ybt3d"]
script = ExtResource("4_yfdhc")
text = "A small Barkling peers out from behind the pylon, bark-skin rustling."
clear_portraits = true

[sub_resource type="Resource" id="Resource_pvqdr"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "Hold the shard out. Don't grab -- offer. Let it feel what you mean."

