[sub_resource type="Resource" id="Resource_nicha"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "There. Bonded. Look after each other -- that is the whole of the science, really."

[sub_resource type="Resource" id="Resource_vwxps"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "The other two stay with me for now. Stay for supper? I want to hear everything about home -- is old Ned still talking to his barley?"

[sub_resource type="Resource" id="Resource_q1713"]
