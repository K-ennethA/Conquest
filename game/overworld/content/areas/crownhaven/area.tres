[sub_resource type="Resource" id="Resource_wkvuj"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_fenwick"
speaker_name = "Old Fenwick"
side = &"right"
text = "In my father's day, the lords bound their creatures in chains -- starstone chains, forged hot. The beasts obeyed. They never loved anyone for it."

[sub_resource type="Resource" id="Resource_ean4t"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_fenwick"
speaker_name = "Old Fenwick"
side = &"right"
text = "Good folk did it the slow way: years of trust, trial and error, bread and patience. Those bonds need no shard at all."

[sub_resource type="Resource" id="Resource_sspk2"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_fenwick"
speaker_name = "Old Fenwick"
side = &"right"
text = "Now the Researcher says almost anyone can do it with a sliver of the same stone. Hm. Stone is stone. It's the hand that holds it."

[sub_resource type="Resource" id="Resource_ybw7y"]
script = ExtResource("8_81lk1")
