[sub_resource type="Resource" id="Resource_b4rx3"]
script = ExtResource("3_3fo44")
text = "By order of the crown: shards of bonding starstone are issued to chosen testers only. The sale, theft or copying of shards is forbidden.
Below, in smaller hand: \"Lost: one Petalfang. Answers to Biscuit.\""
id = &"notice_board"
cell = Vector3i(10, 11, 0)
display_name = "Notice Board"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_i7tb6"]
script = ExtResource("4_bxhkq")
speaker_id = &"npc_orwin"
speaker_name = "Guard Orwin"
side = &"right"
text = "A shard tester, from Oakvale? The Researcher's workshop is in the upper town -- east of the keep. Mind the market crowd."

[sub_resource type="Resource" id="Resource_t8r0m"]
script = ExtResource("5_hodus")
