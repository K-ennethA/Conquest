speaker_id = &"hero"
text = "Oakvale? My mother is in Oakvale!"

[sub_resource type="Resource" id="Resource_qmyeg"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Then we don't stand here talking. My riders are saddling now. Run, and don't stop until you're home."

