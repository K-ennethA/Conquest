[sub_resource type="Resource" id="Resource_fsimy"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_orwin"
speaker_name = "Guard Orwin"
side = &"right"
text = "They came over the EAST wall, and out through my gate before I'd got my spear up. I'll not forget it."

