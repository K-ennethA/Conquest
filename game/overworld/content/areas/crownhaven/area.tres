[sub_resource type="Resource" id="Resource_7i5op"]
script = ExtResource("10_648o0")
label = "Not now."
is_cancel = true

[sub_resource type="Resource" id="Resource_emh7v"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Want to keep your partner sharp? Geode could use the exercise. A friendly bout -- nobody gets hurt for real."

[sub_resource type="Resource" id="Resource_5wk2b"]
script = ExtResource("11_ustyd")
prompt = SubResource("Resource_emh7v")
options = Array[Resource]([SubResource("Resource_v5tpv"), SubResource("Resource_7i5op")])

[sub_resource type="Resource" id="Resource_remfb"]
script = ExtResource("5_efaci")
condition = "spar_ready(\"crownhaven.spar.rowan\")"
then_commands = Array[Resource]([SubResource("Resource_5wk2b")])
else_commands = Array[Resource]([SubResource("Resource_128su")])

[sub_resource type="Resource" id="Resource_on1ni"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "You came. Good. I'm sorry about Oakvale -- I mean that."

[sub_resource type="Resource" id="Resource_aw8b8"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "The council's been shouting since dawn. Cindral's envoy swears his people never sent a raider across the border. Half the lords want to march tomorrow."

[sub_resource type="Resource" id="Resource_q8p5x"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "But those chains, {hero}. Cindral doesn't forge starstone. Someone armed those raiders -- and I mean to find out who before this turns into a war."

[sub_resource type="Resource" id="Resource_6xbe1"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "And your friend Linnea is out there somewhere past that border. I'd sooner go after him with someone who knows what he's worth."

[sub_resource type="Resource" id="Resource_x0ep8"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "I've asked for you on my detail. Rest up at the Wayshrine. When you're ready, we ride."

[sub_resource type="Resource" id="Resource_qn6ff"]
script = ExtResource("7_ej8je")
beats = Array[Resource]([SubResource("Resource_on1ni"), SubResource("Resource_aw8b8"), SubResource("Resource_q8p5x"), SubResource("Resource_6xbe1"), SubResource("Resource_x0ep8")])

