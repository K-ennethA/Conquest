[sub_resource type="Resource" id="Resource_wio6u"]
script = ExtResource("3_hw06u")
text = "CROWNHAVEN -- THE WEST GATE
Royal city of Aldermere. Keep the peace.
West: the Sparse Forest and Woodland Town."
id = &"town_sign"
cell = Vector3i(1, 12, 0)
display_name = "Crownhaven"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_edvgs"]
script = ExtResource("3_hw06u")
text = "CROWNHAVEN -- THE SOUTH GATE
Royal city of Aldermere. Keep the peace.
South: River Crossing, the Mossway and Oakvale."
id = &"south_sign"
cell = Vector3i(12, 27, 0)
display_name = "Crownhaven"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_nyo3i"]
