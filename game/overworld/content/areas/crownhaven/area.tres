[sub_resource type="Resource" id="Resource_l80i7"]
script = ExtResource("4_bxhkq")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Sergeant Rowan, Crownhaven Guard. You'll be one of the Researcher's testers, then."

[sub_resource type="Resource" id="Resource_clal2"]
script = ExtResource("4_bxhkq")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "The army got a crate of her shards. Mine's bonded to a Geode that could hold a bridge by itself. Takes the recruits a month to stop flinching at it."

[sub_resource type="Resource" id="Resource_o1vm1"]
script = ExtResource("5_hodus")
beats = Array[Resource]([SubResource("Resource_l80i7"), SubResource("Resource_clal2")])

[sub_resource type="Resource" id="Resource_ud2c0"]
script = ExtResource("4_bxhkq")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Rest while you can. We ride when the council stops shouting."

[sub_resource type="Resource" id="Resource_4jbs8"]
script = ExtResource("5_hodus")
beats = Array[Resource]([SubResource("Resource_ud2c0")])

[sub_resource type="Resource" id="Resource_sb7di"]
script = ExtResource("4_bxhkq")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "You came. Good. I'm sorry about Oakvale -- I mean that."

[sub_resource type="Resource" id="Resource_ggcae"]
script = ExtResource("4_bxhkq")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "The council's been shouting since dawn. Cindral's envoy swears his people never sent a raider across the border. Half the lords want to march tomorrow."

[sub_resource type="Resource" id="Resource_wwts4"]
script = ExtResource("4_bxhkq")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "But those chains, {hero}. Cindral doesn't forge starstone. Someone armed those raiders -- and I mean to find out who before this turns into a war."

[sub_resource type="Resource" id="Resource_pmwuy"]
script = ExtResource("4_bxhkq")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "I've asked for you on my detail. Rest up at the Wayshrine. When you're ready, we ride."

[sub_resource type="Resource" id="Resource_6gggv"]
script = ExtResource("5_hodus")
beats = Array[Resource]([SubResource("Resource_sb7di"), SubResource("Resource_ggcae"), SubResource("Resource_wwts4"), SubResource("Resource_pmwuy")])

