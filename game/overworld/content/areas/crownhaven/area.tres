[sub_resource type="Resource" id="Resource_ean4t"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "Ah -- the tester from Oakvale! {hero}, isn't it? Come in, come in. Mind the cables."

[sub_resource type="Resource" id="Resource_sspk2"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "You know the old ways. Chains of starstone, forged hot, for those who wanted obedience. Years of patience for those who wanted a friend."

[sub_resource type="Resource" id="Resource_ybw7y"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "This shard is cut from the same starstone -- but tuned to listen, not to bind. Almost anyone can forge a true bond with it. Only a handful of testers have one yet, and the army a few crates."

[sub_resource type="Resource" id="Resource_djkmn"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "Which is why I am told to hand them out slowly, and never to say where they're kept. Now -- someone has been waiting to meet you."

[sub_resource type="Resource" id="Resource_5fdwv"]
script = ExtResource("5_efaci")
beats = Array[Resource]([SubResource("Resource_ean4t"), SubResource("Resource_sspk2"), SubResource("Resource_ybw7y"), SubResource("Resource_djkmn")])

