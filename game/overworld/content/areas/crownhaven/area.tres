id = &"east_gate_sign"
cell = Vector3i(28, 12, 0)
display_name = "The Redrock Road"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_t52w8"]
script = ExtResource("3_hw06u")
