side = &"right"
text = "South! Out the south gate -- over the river, on the road to River Crossing!"

[sub_resource type="Resource" id="Resource_rcgle"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "River Crossing, then the Mossway. It runs to Oakvale, and on to the border. They'll cut straight through the village."

[sub_resource type="Resource" id="Resource_id73y"]
