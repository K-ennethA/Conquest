[sub_resource type="Resource" id="Resource_yes86"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_corin"
speaker_name = "Corin"
side = &"right"
text = "A select few testers, and a crate for the army. Everyone else keeps waiting. That's how it always goes, isn't it?"

[sub_resource type="Resource" id="Resource_wynem"]
script = ExtResource("5_efaci")
beats = Array[Resource]([SubResource("Resource_yes86")])

[sub_resource type="Resource" id="Resource_yiny5"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_corin"
speaker_name = "Corin"
side = &"right"
text = "Cindral raiders, they're saying. Funny -- Cindral has no shards of its own. So why come all this way for the woman who makes them?"

[sub_resource type="Resource" id="Resource_dna8y"]
script = ExtResource("5_efaci")
