[sub_resource type="Resource" id="Resource_5fdwv"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_brisa"
speaker_name = "Brisa"
side = &"right"
text = "I was in the first batch of testers! Biscuit here trusted me the moment the shard warmed. You'll see -- it feels like a second heartbeat."

[sub_resource type="Resource" id="Resource_rca6i"]
script = ExtResource("5_efaci")
