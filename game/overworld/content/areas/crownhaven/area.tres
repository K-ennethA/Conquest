[sub_resource type="Resource" id="Resource_owmq2"]
script = ExtResource("6_vdhnd")
text = "Three small creatures peer out from behind the pylon -- a Barkling, a Petalfang and a Blightcap -- each one watching you with bright, wary eyes."
clear_portraits = true

[sub_resource type="Resource" id="Resource_iqppl"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "My three test creatures. They answered the pylon this morning. Here -- the shard is yours. Don't grab -- offer. Let them feel what you mean, and see which of them answers YOU."

[sub_resource type="Resource" id="Resource_qmkj0"]
script = ExtResource("6_vdhnd")
text = "The shard warms in your palm like a second heartbeat."
