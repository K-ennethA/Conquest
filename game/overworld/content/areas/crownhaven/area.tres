[sub_resource type="Resource" id="Resource_8qtku"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_lark"
speaker_name = "Lark"
side = &"right"
text = "So YOU'RE the one from Oakvale. The tester who rode with the Sergeant."

[sub_resource type="Resource" id="Resource_tvmc5"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_lark"
speaker_name = "Lark"
side = &"right"
text = "I'm Lark. First batch -- the Researcher picked me months before he sent for his old friend from Oakvale. Everyone in the barracks is talking about you, and I'm sick of it."

[sub_resource type="Resource" id="Resource_e75s3"]
script = ExtResource("6_vdhnd")
speaker_id = &"hero"
text = "My village burned, Lark. I didn't do it to be talked about."

[sub_resource type="Resource" id="Resource_bvh5s"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_lark"
speaker_name = "Lark"
side = &"right"
text = "...I know. I'm sorry about that. Truly. But a shard is a shard, and I want to see what yours can do. One bout -- a friendly. Nobody gets hurt."

