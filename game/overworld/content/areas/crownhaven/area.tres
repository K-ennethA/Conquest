[sub_resource type="Resource" id="Resource_tdb81"]
script = ExtResource("4_bxhkq")
speaker_id = &"npc_lisk"
speaker_name = "Private Lisk"
side = &"right"
text = "The army got a crate of the Researcher's shards last month. Only the officers carry them. The Sergeant's Geode could flatten this dummy with one arm."

[sub_resource type="Resource" id="Resource_w5rbo"]
script = ExtResource("5_hodus")
beats = Array[Resource]([SubResource("Resource_tdb81")])

[sub_resource type="Resource" id="Resource_751mc"]
script = ExtResource("4_bxhkq")
speaker_id = &"npc_lisk"
speaker_name = "Private Lisk"
side = &"right"
text = "The Sergeant says we're on alert till the King decides what this raid means. I think it means war."

