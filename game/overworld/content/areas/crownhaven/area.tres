[sub_resource type="Resource" id="Resource_6h2y4"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Which way did they go?"

[sub_resource type="Resource" id="Resource_ss1uq"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_tam"
speaker_name = "Tam"
side = &"right"
text = "South! Out the south gate -- over the river, on the road to River Crossing!"

[sub_resource type="Resource" id="Resource_kkfud"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "River Crossing, then the Mossway. It runs to Oakvale, and on to the border. They'll cut straight through the village."

[sub_resource type="Resource" id="Resource_dm5f6"]
script = ExtResource("6_vdhnd")
speaker_id = &"hero"
text = "Oakvale? My mother is in Oakvale!"

[sub_resource type="Resource" id="Resource_owruj"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Then we don't stand here talking. My riders are saddling now. Run, and don't stop until you're home."

