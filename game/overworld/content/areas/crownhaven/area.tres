[sub_resource type="Resource" id="Resource_yiny5"]
script = ExtResource("6_vdhnd")
speaker_id = &"npc_linnea"
speaker_name = "Researcher Linnea"
side = &"right"
text = "Well, {hero}? Which one answers you?"

[sub_resource type="Resource" id="Resource_dna8y"]
script = ExtResource("11_ustyd")
