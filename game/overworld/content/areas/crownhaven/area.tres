[sub_resource type="Resource" id="Resource_y3u6u"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_baker"
speaker_name = "Baker Gilly"
side = &"right"
text = "Starstone buns! Get your starstone buns! ...No, there's no starstone in them. There's currants. Glowing currants would be a health hazard."

[sub_resource type="Resource" id="Resource_xbdn6"]
script = ExtResource("8_81lk1")
