[sub_resource type="Resource" id="Resource_e4m5u"]
script = ExtResource("4_yfdhc")
speaker_id = &"npc_brisa"
speaker_name = "Brisa"
side = &"right"
text = "If they took the Researcher for her shards... then everyone who carries one is a target now. Keep yours hidden, {hero}."

