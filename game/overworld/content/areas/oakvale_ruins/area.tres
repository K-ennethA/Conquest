[sub_resource type="Resource" id="Resource_5x3ga"]
script = ExtResource("3_0h2dx")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Take the moment you need. I'll hold here -- come and find me when you're ready."

