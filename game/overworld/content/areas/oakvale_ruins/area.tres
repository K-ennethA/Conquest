[sub_resource type="Resource" id="Resource_n4y1c"]
script = ExtResource("3_0h2dx")
speaker_id = &"npc_hessa"
speaker_name = "Hessa"
side = &"right"
text = "{hero}... I'm so sorry."

[sub_resource type="Resource" id="Resource_jk8ot"]
script = ExtResource("3_0h2dx")
speaker_id = &"npc_hessa"
speaker_name = "Hessa"
side = &"right"
text = "When the fires started, your mother got Pell and the little ones down into the mill cellar. Then she went back for old Maud, who can't walk."

[sub_resource type="Resource" id="Resource_3sbfa"]
script = ExtResource("3_0h2dx")
speaker_id = &"npc_hessa"
speaker_name = "Hessa"
side = &"right"
text = "The roof came down. She didn't come out."

[sub_resource type="Resource" id="Resource_ji73d"]
script = ExtResource("3_0h2dx")
text = "For a long moment, there is nothing to say at all."
clear_portraits = true

[sub_resource type="Resource" id="Resource_ma0sd"]
script = ExtResource("3_0h2dx")
speaker_id = &"hero"
text = "She sent me to Crownhaven this morning. She told me to mind myself."

[sub_resource type="Resource" id="Resource_begjm"]
script = ExtResource("4_nnjv4")
beats = Array[Resource]([SubResource("Resource_n4y1c"), SubResource("Resource_jk8ot"), SubResource("Resource_3sbfa"), SubResource("Resource_ji73d"), SubResource("Resource_ma0sd")])

[sub_resource type="Resource" id="Resource_vg2i3"]
script = ExtResource("11_v74we")
key = "opening.rowan_arrived"

[sub_resource type="Resource" id="Resource_tap12"]
script = ExtResource("18_7rg4w")
actor = "rowan"
to = Vector3i(4, 8, 0)

[sub_resource type="Resource" id="Resource_d60od"]
script = ExtResource("20_axyh4")
actor = "player"
facing = "toward:rowan"

[sub_resource type="Resource" id="Resource_6773u"]
script = ExtResource("3_0h2dx")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Sergeant Rowan, Crownhaven Guard. We rode in on the raiders' heels. I heard -- I'm sorry. Truly."

[sub_resource type="Resource" id="Resource_kyhkk"]
script = ExtResource("3_0h2dx")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Your village wasn't their target. It was only in their way. To them, that's all this was."

[sub_resource type="Resource" id="Resource_40o20"]
script = ExtResource("3_0h2dx")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Their rear guard has dug in past the mill with chained beasts -- black chains, starstone links -- holding the road so the rest can get the Researcher over the border."

[sub_resource type="Resource" id="Resource_ehm6c"]
script = ExtResource("3_0h2dx")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "I can't give her back to you. Nobody can. But my Geode and I are going in, and I won't pretend you haven't earned the right to stand with us. Will you fight?"

[sub_resource type="Resource" id="Resource_p2i7w"]
script = ExtResource("4_nnjv4")
beats = Array[Resource]([SubResource("Resource_6773u"), SubResource("Resource_kyhkk"), SubResource("Resource_40o20"), SubResource("Resource_ehm6c")])

[sub_resource type="Resource" id="Resource_u2674"]
script = ExtResource("11_v74we")
key = "opening.ruins_seen"

[sub_resource type="Resource" id="Resource_oa47j"]
script = ExtResource("3_0h2dx")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Then keep your Barkling close, and stay on my shield side."

[sub_resource type="Resource" id="Resource_ryw37"]
script = ExtResource("4_nnjv4")
beats = Array[Resource]([SubResource("Resource_oa47j")])

[sub_resource type="Resource" id="Resource_dvdbf"]
script = ExtResource("8_okps7")
area_id = &"oakvale_ruins"
entry = &"wayshrine"

[sub_resource type="Resource" id="Resource_ire0d"]
script = ExtResource("10_wt1jq")
encounter_id = "story.opening.first_fight"
map_path = "res://game/overworld/content/battles/ow_oakvale_ashes.tres"
ai_difficulty = 0
opponent_name = "Cindral Raiders"
opponent_speaker_id = &"npc_raider_captain"
opponent_team = Array[Dictionary]([{
"character_id": "undead",
"strength": 1.0
}, {
"character_id": "undead",
"strength": 1.0
}, {
"character_id": "monster",
"strength": 1.0
}])
reward_flags = Array[String](["opening.first_fight_won"])
defeat_policy = 2
clash_intro = true

[sub_resource type="Resource" id="Resource_s8p3m"]
script = ExtResource("9_b3y4o")
spec = SubResource("Resource_ire0d")

[sub_resource type="Resource" id="Resource_altpn"]
script = ExtResource("3_0h2dx")
text = "The last chained beast falls. Beyond the mill, hoofbeats fade toward the border."
clear_portraits = true

[sub_resource type="Resource" id="Resource_s18tf"]
script = ExtResource("3_0h2dx")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "That's the rear guard broken. The rest got away with the Researcher -- over the border by nightfall, I'd wager."

[sub_resource type="Resource" id="Resource_qnp4o"]
script = ExtResource("3_0h2dx")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "You fought like you had something to fight for. Your mother would have been proud of you -- and furious with me for letting you."

[sub_resource type="Resource" id="Resource_nibyy"]
script = ExtResource("3_0h2dx")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "The King will call this an act of war. Cindral will swear it never sent a soul. And something about this whole raid stinks."

[sub_resource type="Resource" id="Resource_tedvx"]
script = ExtResource("3_0h2dx")
speaker_id = &"npc_rowan"
speaker_name = "Rowan"
side = &"right"
text = "Bury your mother, {hero}. Then come and find me at the barracks in Crownhaven. I could use someone with a shard -- and a reason."

[sub_resource type="Resource" id="Resource_8k3od"]
script = ExtResource("3_0h2dx")
text = "Sergeant Rowan mounts up and rides east. That evening, the village raises a cairn for Briony beside the house she built."
clear_portraits = true

[sub_resource type="Resource" id="Resource_p17gn"]
script = ExtResource("4_nnjv4")
beats = Array[Resource]([SubResource("Resource_altpn"), SubResource("Resource_s18tf"), SubResource("Resource_qnp4o"), SubResource("Resource_nibyy"), SubResource("Resource_tedvx"), SubResource("Resource_8k3od")])

