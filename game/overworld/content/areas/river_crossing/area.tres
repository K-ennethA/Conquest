[sub_resource type="Resource" id="Resource_lvt5j"]
script = ExtResource("6_qpsqo")
text = "River Crossing. The river slides wide and green under the Old Bridge, and the toll-keeper's lantern swings from its stone rail."
clear_portraits = true

[sub_resource type="Resource" id="Resource_qot7i"]
