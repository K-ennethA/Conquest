[sub_resource type="Resource" id="Resource_u4wfy"]
script = ExtResource("3_qx6el")
text = "THE OLD BRIDGE
Older than the kingdom; kept by the crown.
North: Crownhaven.  West: the Mossway to Oakvale.
East: the coast road to Beach Village (closed)."
id = &"bridge_sign"
cell = Vector3i(10, 11, 0)
display_name = "The Old Bridge"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_5307s"]
script = ExtResource("3_qx6el")
text = "A worn milestone: \"CROWNHAVEN -- THE SOUTH GATE\". Someone has carved a little crown under the letters."
look = "stone"
id = &"milestone"
cell = Vector3i(13, 2, 0)
display_name = "Milestone"
tint = Color(0.55, 0.9, 0.6, 1)

