[resource]
resource_name = "MapResource"
script = ExtResource("1_mulxk")
map_name = "Woodland Town"
description = "Woodland Town: a timber town in a clearing at the edge of the Sparse Forest -- log cabins, a lumber yard, a stream with a plank bridge. Story-mode terrain."
