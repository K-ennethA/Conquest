facing = "east"
display_name = "Gran Wicke"
tint = Color(0.7, 0.68, 0.74, 1)
on_interact = Array[Resource]([SubResource("Resource_35cwe")])

[sub_resource type="Resource" id="Resource_kq1jr"]
script = ExtResource("4_wrcc3")
speaker_id = &"npc_stranger"
speaker_name = "Cloaked Stranger"
side = &"right"
text = "Warm fire, warm night. You've the look of someone who counts doors and exits, traveller. Good habit."

[sub_resource type="Resource" id="Resource_rotus"]
script = ExtResource("4_wrcc3")
speaker_id = &"npc_stranger"
speaker_name = "Cloaked Stranger"
side = &"right"
text = "Some doors in this wood are only doors if you know the knock. I'd tell you the knock, but I don't know it. Obviously."

[sub_resource type="Resource" id="Resource_3778o"]
script = ExtResource("5_mqkfy")
beats = Array[Resource]([SubResource("Resource_kq1jr"), SubResource("Resource_rotus")])

