[sub_resource type="Resource" id="Resource_hg154"]
script = ExtResource("4_wrcc3")
speaker_id = &"npc_wicke"
speaker_name = "Gran Wicke"
side = &"right"
text = "When I was a girl this stone was taller. Or I was shorter. The glade keeps its own counsel."

[sub_resource type="Resource" id="Resource_8tck5"]
script = ExtResource("4_wrcc3")
speaker_id = &"npc_wicke"
speaker_name = "Gran Wicke"
side = &"right"
text = "If you're ever lost in the woods, set your hand on a stone and listen. The star remembers the way home."

