[sub_resource type="Resource" id="Resource_2guil"]
script = ExtResource("4_wrcc3")
speaker_id = &"npc_ferra"
speaker_name = "Huntress Ferra"
side = &"right"
text = "Three arrows, three straw men, and one of them is still standing. Don't ask which. The range is open to anyone who can keep from shooting the pigeons."

