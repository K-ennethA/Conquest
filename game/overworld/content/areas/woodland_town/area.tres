[sub_resource type="Resource" id="Resource_628w3"]
script = ExtResource("4_wrcc3")
speaker_id = &"npc_ilse"
speaker_name = "Herbalist Ilse"
side = &"right"
text = "Bitterroot for stings, mossleaf for scrapes, and something I'm not allowed to call a cure for anything at all. Don't tell the Wardens."

[sub_resource type="Resource" id="Resource_5kh6c"]
script = ExtResource("4_wrcc3")
speaker_id = &"npc_ilse"
speaker_name = "Herbalist Ilse"
side = &"right"
text = "The woods are older than the kingdom, you know. Things sleep in the roots out there. Nobody here says so aloud."

