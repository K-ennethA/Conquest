[sub_resource type="Resource" id="Resource_ccc16"]
script = ExtResource("4_wrcc3")
speaker_id = &"npc_fern"
speaker_name = "Fern"
side = &"right"
text = "I counted forty-one lanterns last night and only forty windows. Nobody believes me."

