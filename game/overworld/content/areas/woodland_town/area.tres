[sub_resource type="Resource" id="Resource_v62xw"]
script = ExtResource("4_wrcc3")
speaker_id = &"npc_bryn"
speaker_name = "Innkeeper Bryn"
side = &"right"
text = "Venison pie, hot cider, and a room with a window onto the pines. The Stumped Hart's never let a traveller go hungry."

[sub_resource type="Resource" id="Resource_6xbmb"]
script = ExtResource("4_wrcc3")
speaker_id = &"npc_bryn"
speaker_name = "Innkeeper Bryn"
side = &"right"
text = "Odd crowd lately. Folk with no luggage and a lot of questions about the south trail. I tell them it's a trail to nowhere."

