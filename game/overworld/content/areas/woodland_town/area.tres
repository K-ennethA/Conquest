[sub_resource type="Resource" id="Resource_dq76t"]
script = ExtResource("4_wrcc3")
speaker_id = &"npc_burr"
speaker_name = "Smith Burr"
side = &"right"
text = "Axe heads, saw teeth, nails by the barrel. The Guard's smiths in the city make swords. I make the things that actually feed people."

