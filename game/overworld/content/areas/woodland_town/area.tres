[sub_resource type="Resource" id="Resource_wdowa"]
script = ExtResource("3_1aipj")
text = "WOODLAND TOWN
Timber, tolls and tall tales. East: Crownhaven.  West: Deepwood Village (road closed)."
id = &"town_sign"
cell = Vector3i(26, 13, 0)
display_name = "Woodland Town"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_r2i4f"]
script = ExtResource("3_1aipj")
text = "THE WARDENS' LODGE
Tolls, maps, and the loan of a lantern. Ask for Warden Hale."
id = &"lodge_sign"
cell = Vector3i(10, 9, 0)
display_name = "The Wardens' Lodge"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_o7ttn"]
script = ExtResource("3_1aipj")
text = "THE STUMPED HART
A stump for a stool, a stag for a sign. Venison pie daily."
id = &"inn_sign"
cell = Vector3i(17, 10, 0)
display_name = "The Stumped Hart"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_m2cea"]
script = ExtResource("3_1aipj")
text = "HAMMOND & DAUGHTERS -- LUMBER
Cut green, sold dry.
Do not lean on the stacks."
id = &"yard_sign"
cell = Vector3i(18, 13, 0)
display_name = "Lumber Yard"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_2j6rj"]
script = ExtResource("3_1aipj")
text = "WEST: DEEPWOOD VILLAGE
The road is closed by the Wardens. Ask at the Lodge."
id = &"deepwood_sign"
cell = Vector3i(2, 13, 0)
display_name = "To Deepwood"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_crl2q"]
script = ExtResource("3_1aipj")
text = "A hand-lettered board nailed to a root:
\"NOT A ROAD. Not a trail. Not your business.\""
id = &"trail_sign"
cell = Vector3i(5, 19, 0)
display_name = "The South Trail"
tint = Color(0.52, 0.36, 0.2, 1)

[sub_resource type="Resource" id="Resource_7uahq"]
script = ExtResource("3_1aipj")
text = "A knee-high stone, furred with moss and scored with old marks. Fresh flowers lie before it. It hums very faintly, like a held note."
look = "stone"
id = &"standing_stone"
cell = Vector3i(3, 17, 0)
display_name = "The Starfall Stone"
tint = Color(0.55, 0.9, 0.6, 1)

[sub_resource type="Resource" id="Resource_b8d28"]
script = ExtResource("4_wrcc3")
speaker_id = &"npc_hale"
speaker_name = "Warden Hale"
side = &"right"
text = "Welcome to Woodland Town. The Wardens keep the roads, the tolls and the peace between the town and the trees -- in about that order of difficulty."

[sub_resource type="Resource" id="Resource_2j0bs"]
script = ExtResource("4_wrcc3")
speaker_id = &"npc_hale"
speaker_name = "Warden Hale"
side = &"right"
text = "Deepwood's road is shut. The wood's been restless, and a restless wood eats carts. If you want to go west, bring me a reason I can write down."

[sub_resource type="Resource" id="Resource_tg31k"]
script = ExtResource("4_wrcc3")
speaker_id = &"npc_hale"
speaker_name = "Warden Hale"
side = &"right"
text = "And if you meet a lantern in the dark that nobody's holding -- go the other way."

[sub_resource type="Resource" id="Resource_82v5q"]
script = ExtResource("5_mqkfy")
beats = Array[Resource]([SubResource("Resource_b8d28"), SubResource("Resource_2j0bs"), SubResource("Resource_tg31k")])

