[sub_resource type="Resource" id="Resource_2vmoj"]
script = ExtResource("4_wrcc3")
text = "The road west thins to a deer track and then to nothing. Somewhere beyond the thorns lies Deepwood Village -- but the Wardens have strung a rope across the track with a painted warning: \"No travellers. Ask at the Lodge.\""
clear_portraits = true

[sub_resource type="Resource" id="Resource_quki3"]
script = ExtResource("7_6u3lw")
scene_id = &"wt_west_locked"
beats = Array[Resource]([SubResource("Resource_2vmoj")])

[sub_resource type="Resource" id="Resource_er06v"]
script = ExtResource("11_wyfs0")
area_rect = Rect2i(0, 12, 1, 1)
target_area = &"woodland_town"
target_entry = &"west_road"
requires = "has(\"world.deepwood_open\")"
locked_scene = SubResource("Resource_quki3")
id = &"west_exit"
blocking = false

[sub_resource type="Resource" id="Resource_7y84g"]
script = ExtResource("4_wrcc3")
text = "A narrow trail slips south between the roots, toward a cave mouth nobody here admits to knowing. Fresh boot prints say the way is kept open from the other end. A rockfall blocks it for now."
clear_portraits = true

[sub_resource type="Resource" id="Resource_ar7d7"]
script = ExtResource("7_6u3lw")
scene_id = &"wt_south_locked"
beats = Array[Resource]([SubResource("Resource_7y84g")])

[sub_resource type="Resource" id="Resource_uat2p"]
script = ExtResource("11_wyfs0")
area_rect = Rect2i(4, 23, 1, 1)
target_area = &"woodland_town"
target_entry = &"wayshrine"
requires = "has(\"world.thieves_guild_open\")"
locked_scene = SubResource("Resource_ar7d7")
id = &"south_exit"
blocking = false

[sub_resource type="Resource" id="Resource_4iue0"]
script = ExtResource("4_wrcc3")
text = "Woodland Town. The air smells of pine resin and woodsmoke, and somewhere a saw sings through green timber. Lanterns still burn in the cabin windows against the morning mist."
clear_portraits = true

[sub_resource type="Resource" id="Resource_yut8i"]
script = ExtResource("4_wrcc3")
text = "The Wardens' Lodge stands at the heart of the town, north of the boardwalk square. The lumber yard is east, past the inn; the old trail south runs toward the Hidden Thieves Guild."
clear_portraits = true

[sub_resource type="Resource" id="Resource_allec"]
script = ExtResource("5_mqkfy")
beats = Array[Resource]([SubResource("Resource_4iue0"), SubResource("Resource_yut8i")])

