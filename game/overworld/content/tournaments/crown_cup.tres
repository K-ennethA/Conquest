[resource]
script = ExtResource("2_cajlg")
id = &"crown_cup"
display_name = "The Crown Cup"
description = "Four bouts in the sand of The Crown Arena, one after another. Friendly -- nobody is hurt for real -- but the crowd only cheers for winners."
