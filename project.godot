[rendering]

anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/msaa_3d.mobile=1
anti_aliasing/quality/use_debanding=true
textures/vram_compression/import_etc2_astc=true

[shader_globals]

terrain_mask={
"type": "sampler2D",
"value": ""
}
terrain_mask_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
terrain_mask_on={
"type": "float",
"value": 0.0
}
board_rect={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
grid_lines={
"type": "float",
"value": 0.0
}
haze_color={
"type": "vec3",
"value": Vector3(0.66, 0.75, 0.8)
}
weather_wetness={
"type": "float",
"value": 0.0
}
weather_dust={
"type": "float",
"value": 0.0
}
weather_bloom={
"type": "float",
"value": 0.0
}
weather_sun={
"type": "float",
"value": 0.0
}
focus_world={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
wind_strength_global={
"type": "float",
"value": 1.0
}
