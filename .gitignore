# Godot 4+ engine cache — regenerated on open, never commit
.godot/

# Godot 3.x import cache (harmless if present)
.import/

# Exports — build OUTPUT is ignored, the preset definitions are NOT.
# export_presets.cfg is committed on purpose: every machine that builds Conquest for a
# two-machine network test must produce the same exe from the same preset (see
# docs/NETWORK_TESTING.md). NEVER put a keystore password or an encryption key in it —
# those belong in the local, uncommitted export.cfg / environment.
export.cfg
/build/
/exports/

# Godot auto-generated translations
*.translation

# Mono / C# (unused today, safe default)
.mono/
data_*/
mono_crash.*.json

# Claude Code worktrees (agent isolation dirs)
.claude/worktrees/

# OS / editor cruft
.DS_Store
Thumbs.db
*~

# NOTE: *.gd.uid and *.import files ARE intentionally committed —
# Godot 4.4+ uses .uid files for stable resource references.
