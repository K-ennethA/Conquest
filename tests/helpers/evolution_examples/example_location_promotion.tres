[gd_resource type="Resource" script_class="EvolutionResource" format=3]

[ext_resource type="Script" path="res://game/characters/evolution/EvolutionResource.gd" id="1_evo"]
[ext_resource type="Script" path="res://game/characters/evolution/EvolutionTrigger.gd" id="2_trig"]
[ext_resource type="Script" path="res://game/characters/evolution/GrowthTrigger.gd" id="3_growth"]
[ext_resource type="Script" path="res://game/characters/evolution/LocationTrigger.gd" id="4_loc"]

[sub_resource type="Resource" id="Resource_growth1"]
script = ExtResource("3_growth")
growth_required = 1

[sub_resource type="Resource" id="Resource_barracks"]
script = ExtResource("4_loc")
area_ids = PackedStringArray("crownhaven")
place_label = "the Crownhaven barracks"

[resource]
script = ExtResource("1_evo")
id = &"example__blightcap_promotion"
from_id = &"blightcap"
to_id = &"mycothrall"
kind_label = "Promote"
flavor = "EXAMPLE edge (tests only): a class promotion earned at a trainer's order in a place."
triggers = Array[ExtResource("2_trig")]([SubResource("Resource_growth1"), SubResource("Resource_barracks")])
